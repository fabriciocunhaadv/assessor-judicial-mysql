# Server-side Gemini API Key (automatically injected in AI Studio environment)
GEMINI_API_KEY=

# Optional Limits & Config
FREE_TPM_LIMIT=
NODE_ENV=development

# Banco MySQL do Histórico (Hostinger: host localhost). NUNCA coloque a senha no código; só aqui/nas variáveis de ambiente do painel.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Login próprio
SESSION_SECRET=      # texto aleatório longo (mínimo 32 caracteres) que assina as sessões
SUPERADMIN_EMAIL=    # cria o super admin na primeira execução, se ainda não existir
SUPERADMIN_PASSWORD= # senha inicial do super admin (troque depois)
SUPERADMIN_RESET_SENHA= # coloque 'sim' por UMA implantação para redefinir a senha do super admin para SUPERADMIN_PASSWORD; depois apague a variável
