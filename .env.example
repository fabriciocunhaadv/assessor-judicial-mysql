# Server-side Gemini API Key (automatically injected in AI Studio environment)
GEMINI_API_KEY=

# Optional Limits & Config
FREE_TPM_LIMIT=
NODE_ENV=development

# Banco MySQL do Histórico (Hostinger: host localhost). NUNCA coloque a senha no código; só aqui/nas variáveis de ambiente do painel.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
