rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        (request.auth.token.email == 'fabriciocunha.adv@gmail.com' || 
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'));
    }

    function isAdmin() {
      return isSignedIn() &&
        (isSuperAdmin() || 
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'judge', 'magistrado']));
    }

    function isPrimaryTenant(tenantId) {
      return tenantId in ['', 'gabinete_default', 'default', 'gab_rafael_machado', 'rafael_machado', 'montes_claros', 'fazenda_nova', 'principal', 'gabinete_principal'];
    }

    function belongsToTenant(tenantId) {
      return isSuperAdmin() || 
        (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) && isPrimaryTenant(tenantId)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId == tenantId ||
          (isPrimaryTenant(tenantId) && isPrimaryTenant(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId))));
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }
    
    match /invites/{email} {
      allow read, write: if isSignedIn();
    }

    match /tenants/{tenantId} {
      allow read, write: if isSuperAdmin();
      allow read: if isSignedIn();
    }

    match /system_snapshots/{snapshotId} {
      allow read, write: if isSuperAdmin();
      match /{allSubcollections=**} {
        allow read, write: if isSuperAdmin();
      }
    }

    // MINUTAS DO HISTÓRICO: cada usuário só exclui a PRÓPRIA minuta. Um ato do Histórico é reconhecido pelo formato (tem "processNumber" e "result");
    // ele só pode ser apagado por quem o gerou (createdBy == uid) ou pelo super admin (permissão total). Ato antigo sem dono registrado (createdBy ausente ou "anonymous") pode ser apagado por qualquer
    // usuário do gabinete. Leitura, criação e edição continuam como antes. Os demais documentos do gabinete (prompts, teses, etc.) não mudam.
    function ehAtoDoHistorico(dados) {
      return ('processNumber' in dados) && ('result' in dados);
    }
    function podeApagarAto(dados) {
      return isSuperAdmin()
        || !ehAtoDoHistorico(dados)
        || !('createdBy' in dados)
        || dados.createdBy == 'anonymous'
        || dados.createdBy == request.auth.uid;
    }

    match /gabinetes/{tenantId} {
      match /{allSubcollections=**} {
        allow read, create, update: if belongsToTenant(tenantId);
        allow delete: if belongsToTenant(tenantId) && podeApagarAto(resource.data);
      }
    }
    
    // Collections (tenant-scoped and root fallback for seamless transition)
    match /tickets/{ticketId} { 
      // Super admin has full access
      // Cabinet Admin/Judge can read/write tickets belonging to their tenant
      // Author user can read/create/update/delete their own tickets
      allow read: if isSuperAdmin() || 
                     (isSignedIn() && (resource.data.createdByUid == request.auth.uid || resource.data.createdByEmail == request.auth.token.email)) ||
                     (isAdmin() && belongsToTenant(resource.data.tenantId));

      allow create: if isSignedIn() && (
        isSuperAdmin() || 
        (belongsToTenant(request.resource.data.tenantId) && 
         (request.resource.data.createdByUid == request.auth.uid || request.resource.data.createdByEmail == request.auth.token.email))
      );

      allow update: if isSuperAdmin() || 
                       (isSignedIn() && (resource.data.createdByUid == request.auth.uid || resource.data.createdByEmail == request.auth.token.email)) ||
                       (isAdmin() && belongsToTenant(resource.data.tenantId));

      allow delete: if isSuperAdmin() || 
                       (isAdmin() && belongsToTenant(resource.data.tenantId)) ||
                       (isSignedIn() && (resource.data.createdByUid == request.auth.uid || resource.data.createdByEmail == request.auth.token.email) && resource.data.status == 'aguardando');

      match /{allSubcollections=**} {
        allow read, write: if isSuperAdmin() || isSignedIn();
      }
    }
    match /history/{docId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn() && podeApagarAto(resource.data);
    }
    match /prompts/{docId} { allow read, write: if isSignedIn(); }
    match /teses/{docId} { allow read, write: if isSignedIn(); }
    match /knowledge/{docId} { allow read, write: if isSignedIn(); }
    match /audits/{docId} { allow read, write: if isSignedIn(); }
    
    // Módulo Independente de Petição Inicial 360 (Acesso estrito e exclusivo ao Super Admin e usuários autenticados)
    match /initial_petitions_history/{docId} {
      allow read, write, create, update, delete: if isSuperAdmin() || isSignedIn();
    }
    match /initial_petition_templates/{docId} {
      allow read, write, create, update, delete: if isSuperAdmin() || isSignedIn();
    }
    
    // For legacy documents in root (if they are still being accessed during transition)
    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }
  }
}
